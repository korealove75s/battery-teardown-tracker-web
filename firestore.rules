rules_version = '2';
// Only the shared team account (BTT_TEAM_EMAIL in firebase-config.js) can read or write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'team@example.com';
    }
  }
}
