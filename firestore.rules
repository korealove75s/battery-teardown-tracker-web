rules_version = '2';
// Any account registered in Firebase Authentication > Users can read or write.
// Keep "Enable create (sign-up)" turned off in Authentication > Settings > User actions,
// so only accounts added in the console can sign in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
